<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- 深色主题（原来是 Light.DarkActionBar）：系统的对话框、文本选择柄、键盘
         都跟着这个主题走，用浅色的话会在深色页面上冒出一块白。 -->
    <style name="AppTheme" parent="Theme.AppCompat.NoActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
        <item name="android:windowBackground">@color/splashBackground</item>

        <!-- 系统栏透明：页面背景（含背景图）要一直顶到屏幕上沿。
             MainActivity 里也会设一遍，这里先设是为了冷启动那一帧就别闪出黑条。 -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <!-- 页面是深底，图标用浅色 -->
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
    </style>

    <!-- 冷启动那一瞬间的窗口：纯色底，比默认的品牌 splash 图干净，也不会白闪 -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">@color/splashBackground</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
