+/* 实时日志流。
+   手机 App 里切后台是常态：系统会把 SSE 冻住，回到前台后它既不报错也不恢复，
+   一直挂在「已连接」其实是死的。所以除了 EventSource 自带的重连，还要：
+     · CLOSED（彻底断掉，浏览器不会自己再来）→ 指数退避重建
+     · 回到前台 / 页面重新可见 → 若不是 OPEN 就立刻重建
+     · 网络恢复（online）→ 重置退避重连 */
+let logStream = null;
+let streamRetry = 0;
+let streamTimer = null;
+
 function connectStream() {
+  if (logStream) {
+    logStream.close();
+    logStream = null;
+  }
   const es = new EventSource('/api/stream/logs');
+  logStream = es;
+
   es.addEventListener('hello', () => {
+    streamRetry = 0;
     $('streamState').textContent = '已连接，实时接收';
     $('liveDot').classList.remove('off');
   });
@@ -880,9 +897,41 @@ function connectStream() {
   es.onerror = () => {
     $('streamState').textContent = '连接中断，正在重连…';
     $('liveDot').classList.add('off');
+    // 只有 CLOSED 需要自己动手：CONNECTING 状态下浏览器会按自身的节奏重试
+    if (es.readyState === EventSource.CLOSED) scheduleStream();
   };
 }
 
+function scheduleStream() {
+  if (streamTimer) return;
+  const wait = Math.min(30_000, 1000 * 2 ** streamRetry++);
+  streamTimer = setTimeout(() => {
+    streamTimer = null;
+    connectStream();
+  }, wait);
+}
+
+/** 回到前台 / 网络恢复时把「假活」的流换掉 */
+function reviveStream() {
+  if (streamTimer) {
+    clearTimeout(streamTimer);
+    streamTimer = null;
+  }
+  if (logStream && logStream.readyState === EventSource.OPEN) return;
+  streamRetry = 0;
+  connectStream();
+}
+
+document.addEventListener('visibilitychange', () => {
+  if (!document.hidden) reviveStream();
+});
+// iOS/部分安卓 WebView 从后台返回时不一定触发 visibilitychange，pageshow 兜一层
+window.addEventListener('pageshow', reviveStream);
+window.addEventListener('online', () => {
+  streamRetry = 0;
+  connectStream();
+});
+
 /** 标签切换：看板（图形+汇总）与日志/报文分开，首页不被运维细节淹没 */
