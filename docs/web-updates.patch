@@ -0,0 +1,62 @@
+'use strict';
+
+/**
+ * 飞书回调地址的推导规则单测。
+ *
+ * 这条规则决定「App 里点飞书授权能不能走通」：回调写死 localhost 时，手机上
+ * 没有那个 3000 端口，授权链路直接断死。所以地址要能感知当前用哪个域名在访问。
+ *
+ * 跑：npm run test:redirect
+ */
+
+const os = require('os');
+const path = require('path');
+const fs = require('fs');
+
+// 在 require 之前把数据目录指到临时目录：测试会往 config.json 里写值，不能碰真实配置
+const tmp = path.join(os.tmpdir(), 'workcheck-redirect-test');
+fs.rmSync(tmp, { recursive: true, force: true });
+process.env.WORKCHECK_DATA_DIR = tmp;
+
+const config = require('../server/config.js');
+
+/** 造一个够用的 req：只需要 get() 和 protocol */
+const mkReq = (headers, protocol) => ({
+  get: (n) => (headers && headers[String(n).toLowerCase()] !== undefined ? headers[String(n).toLowerCase()] : undefined),
+  protocol,
+});
+
+const PUBLIC = { host: 'workcheck.byeallen.com', 'x-forwarded-proto': 'https' };
+const cases = [
+  ['本地直连（浏览器开 localhost）', mkReq({ host: 'localhost:3000' }, 'http'), 'http://localhost:3000/feishu/callback'],
+  ['公网 + 反代转发了 XFP', mkReq(PUBLIC, 'http'), 'https://workcheck.byeallen.com/feishu/callback'],
+  ['公网 + 反代没转发 XFP（兜底 https）', mkReq({ host: 'workcheck.byeallen.com' }, 'http'), 'https://workcheck.byeallen.com/feishu/callback'],
+  ['XFP 多值取第一个', mkReq({ host: 'workcheck.byeallen.com', 'x-forwarded-proto': 'https, http' }, 'http'), 'https://workcheck.byeallen.com/feishu/callback'],
+  ['X-Forwarded-Host 优先于 Host', mkReq({ host: '127.0.0.1:3000', 'x-forwarded-host': 'workcheck.byeallen.com', 'x-forwarded-proto': 'https' }, 'http'), 'https://workcheck.byeallen.com/feishu/callback'],
+  ['非法 host（注入）回落常量', mkReq({ host: 'evil.com\r\nX: y' }, 'https'), config.DEFAULT_REDIRECT],
+  ['拿不到 req（定时任务）回落常量', undefined, config.DEFAULT_REDIRECT],
+];
+
+let fail = 0;
+function check(name, got, want) {
+  const ok = got === want;
+  if (!ok) fail++;
+  console.log(`${ok ? 'PASS' : 'FAIL'}  ${name}`);
+  if (!ok) console.log(`      got=${got}\n      want=${want}`);
+}
+
+for (const [name, req, want] of cases) check(name, config.getRedirect(req), want);
+
+// 显式配置的优先级
+config.save('feishu', { appId: 'cli_test', appSecret: 's', redirectUri: 'https://custom.example.com/feishu/callback' });
+check('显式配置覆盖推导', config.getRedirect(mkReq(PUBLIC, 'http')), 'https://custom.example.com/feishu/callback');
+
+// 历史遗留的 localhost：公网访问时让位，本地访问时保留
+config.save('feishu', { redirectUri: 'http://localhost:3000/feishu/callback' });
+check('存着的 localhost 在公网访问时让位', config.getRedirect(mkReq(PUBLIC, 'http')), 'https://workcheck.byeallen.com/feishu/callback');
+check('同一个配置在本地访问时保留', config.getRedirect(mkReq({ host: 'localhost:3000' }, 'http')), 'http://localhost:3000/feishu/callback');
+check('同一个配置在本机 127.0.0.1 访问时保留', config.getRedirect(mkReq({ host: '127.0.0.1:3000' }, 'http')), 'http://localhost:3000/feishu/callback');
+
+fs.rmSync(tmp, { recursive: true, force: true });
+console.log(fail === 0 ? `\n全部通过（${cases.length + 4} 项）` : `\n失败 ${fail} 项`);
+process.exit(fail === 0 ? 0 : 1);
