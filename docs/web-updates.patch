+  if (!/^(?:[a-z0-9](?:[a-z0-9-]*[a-z0-9])?\.)+[a-z]{2,}(?::\d+)?$|^localhost(?::\d+)?$|^127\.0\.0\.1(?::\d+)?$|^\[[0-9a-f:]+\](?::\d+)?$/.test(host)) {
+    return '';
