+ * 拿 req.protocol 拼会拼出 http://，与飞书白名单里的 https 对不上。
+ * 连 X-Forwarded-Proto 都没有时，非本机访问一律按 https 算（公网服务几乎必然是 https，
+ * 且站点已开 HSTS）；本地 localhost 才回落 http。
+ */
+function deriveRedirect(req) {
+  if (!req || typeof req.get !== 'function') return '';
+  const host = String(req.get('x-forwarded-host') || req.get('host') || '')
+    .split(',')[0]
+    .trim()
+    .toLowerCase();
